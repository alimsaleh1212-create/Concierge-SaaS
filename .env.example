# ── User-supplied values ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values below.
# These are read once by vault/init.sh at first `docker compose up` to
# bootstrap Vault. After that the app loads everything from Vault at runtime.

VAULT_ROOT_TOKEN=dev-root-token
GROQ_API_KEY=gsk_...
VOYAGE_API_KEY=pa-...

# Groq model used by the API and the guardrails sidecar (must support tool calling).
# The guardrails model is set separately in guardrails/config/config.yml.
GROQ_MODEL=openai/gpt-oss-120b

# ── Vault address (default matches docker-compose.yml) ───────────────────────
# Override only if you run Vault outside Docker Compose.
VAULT_ADDR=http://localhost:8200

# ── Secrets managed by Vault (do NOT set these manually) ────────────────────
# vault/init.sh writes the following paths to Vault dev at startup:
#   secret/data/concierge → DATABASE_URL, SYSTEM_DATABASE_URL, REDIS_URL, MINIO_ENDPOINT,
#                            MINIO_ACCESS_KEY, MINIO_SECRET_KEY,
#                            MODELSERVER_SERVICE_TOKEN, GUARDRAILS_SERVICE_TOKEN,
#                            GROQ_API_KEY, VOYAGE_API_KEY
